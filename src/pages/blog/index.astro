---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import PostCard from '../../components/PostCard.astro';
import Tag from '../../components/Tag.astro';
import { getPosts } from '../../lib/posts';

const page = await getEntry('pages', 'blog');
if (!page) throw new Error('src/content/pages/blog.md is missing');

const posts = await getPosts();
const featured = posts.filter((post) => post.data.featured).slice(0, 2);
const rest = posts.filter((post) => !featured.includes(post));
const count = `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`;
---
<Base title="Blog" description={page.data.subtitle} rss>
  <PageHero title={page.data.title} subtitle={page.data.subtitle} />
  {posts.length === 0 ? (
    <p class="empty">
      <span>{page.data.empty ?? 'First posts are on the way.'}</span>
      <Tag href="/rss.xml">rss</Tag>
    </p>
  ) : (
    <>
      {featured.length > 0 && (
        <section class="block featured-block">
          <SectionLabel label="featured" as="h2">
            <a href="/rss.xml" aria-label="RSS feed">rss</a>
          </SectionLabel>
          <div class="featured">
            {featured.map((post) => <PostCard post={post} featured />)}
          </div>
        </section>
      )}
      {rest.length > 0 && (
        <section class="block">
          <SectionLabel label="all posts" as="h2">
            <span class="label-end">
              <span>{count}</span>
              {featured.length === 0 && <a href="/rss.xml" aria-label="RSS feed">rss</a>}
            </span>
          </SectionLabel>
          <div class="grid">
            {rest.map((post) => <PostCard post={post} />)}
          </div>
        </section>
      )}
    </>
  )}
</Base>

<style>
  .block {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .label-end {
    display: inline-flex;
    gap: 16px;
  }

  .featured-block {
    margin-bottom: 48px;
  }

  .featured {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .featured > :global(*) {
    flex: 1 1 420px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(max(300px, calc((100% - 40px) / 3)), 1fr));
    gap: 20px;
  }

  .empty {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--text-body);
  }

  @media (max-width: 480px) {
    .featured > :global(*) {
      flex-basis: 100%;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
