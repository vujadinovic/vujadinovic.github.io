---
import Illustration from './Illustration.astro';
import Tag from './Tag.astro';
import { postUrl, type Post } from '../lib/posts';

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
---
<a class:list={['card', { featured }]} href={postUrl(post)}>
  <Illustration name={post.data.cover} height={featured ? 300 : 210} padding={8} variant="card" />
  <div class="card-body">
    <Tag size="small">{post.data.category}</Tag>
    <h2>{post.data.title}</h2>
    {featured && <p>{post.data.description}</p>}
  </div>
</a>

<style>
  .card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .card:focus-visible {
    border-radius: var(--radius-card);
  }

  .card-body {
    padding: 20px 24px 26px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  h2 {
    font-size: 18px;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .featured h2 {
    font-size: 21px;
  }

  p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-body);
    max-width: 52ch;
  }
</style>
