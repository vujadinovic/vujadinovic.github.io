---
interface Props {
  label: string;
}

const { label } = Astro.props;
---
<div class="meta-row">
  <dt>{label}:</dt>
  <dd><slot /></dd>
</div>

<style>
  .meta-row {
    display: flex;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line-soft);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
  }

  dt {
    flex: 0 0 132px;
    color: var(--text-muted);
  }

  dd {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    color: var(--text);
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    overflow-wrap: anywhere;
  }
</style>
