---
const pixels = [
  [1, 2], [2, 2], [3, 2], [4, 2],
  [0, 3],
  [1, 4], [2, 4], [3, 4],
  [4, 5],
  [0, 6], [1, 6], [2, 6], [3, 6],
];
---
<div class="logo">
  <button
    type="button"
    class="logo-button"
    aria-label="Stop cursor animation"
    aria-pressed="false"
    aria-describedby="logo-tip"
    data-cursor-toggle
  >
    <svg width="30" height="21" viewBox="0 0 10 7" shape-rendering="crispEdges" aria-hidden="true">
      <g fill="#E2DDD4">
        {pixels.map(([x, y]) => <rect x={x} y={y} width="1" height="1" />)}
      </g>
      <rect class="logo-cursor" x="6.5" y="2" width="3" height="5" fill="#F0A43A" />
    </svg>
  </button>
  <span id="logo-tip" role="tooltip" class="logo-tip">
    <span class="tip-on">click if animation annoys you</span>
    <span class="tip-off">click to turn it back on</span>
  </span>
</div>

<style>
  .logo {
    position: relative;
    display: flex;
  }

  .logo-button {
    display: flex;
    align-items: center;
    height: 32px;
    padding: 0 9px;
    border: 0;
    border-radius: var(--radius-chip);
    background: var(--surface);
    cursor: pointer;
  }

  .logo-button:focus-visible {
    border-radius: var(--radius-chip);
  }

  .logo-button svg {
    display: block;
  }

  .logo-cursor {
    animation: blink 1.1s steps(1) infinite;
  }

  :global(html[data-cursor='off']) .logo-cursor {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-cursor {
      animation: none;
    }
  }

  @keyframes blink {
    0%,
    55% {
      opacity: 1;
    }
    56%,
    100% {
      opacity: 0;
    }
  }

  .logo-tip {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 20;
    padding: 5px 9px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-chip);
    background: var(--surface);
    color: var(--text-body);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    white-space: nowrap;
    visibility: hidden;
    pointer-events: none;
  }

  .logo:hover .logo-tip,
  .logo-button:focus-visible + .logo-tip {
    visibility: visible;
  }

  .tip-off {
    display: none;
  }

  :global(html[data-cursor='off']) .tip-on {
    display: none;
  }

  :global(html[data-cursor='off']) .tip-off {
    display: inline;
  }
</style>
